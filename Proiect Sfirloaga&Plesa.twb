          <datasource-dependencies datasource='federated.1ayj8xl1dtq7lx13hxtgm028bjy7'>
            <column caption='Colorare după Prag' datatype='boolean' name='[Calculation_0320466523152386]' role='measure' type='nominal'>
              <calculation class='tableau' formula='AVG([track_popularity]) &gt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Album Name' datatype='string' name='[album_name]' role='dimension' type='nominal' />
            <column-instance column='[track_popularity]' derivation='Avg' name='[avg:track_popularity:qk]' pivot='key' type='quantitative' />
