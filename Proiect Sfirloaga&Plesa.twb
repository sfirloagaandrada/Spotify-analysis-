            <column caption='Track Popularity (Spotify Data Clean.Csv)' datatype='integer' name='[track_popularity (spotify_data clean.csv)]' role='measure' type='quantitative' />
            <column caption='Track Popularity' datatype='integer' name='[track_popularity]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[avg:track_popularity (spotify_data clean.csv):qk]' included-values='non-null' />
          <filter class='categorical' column='[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[none:Calculation_0320466494787584:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_0320466494787584:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
