          </datasources>
          <datasource-dependencies datasource='federated.1ayj8xl1dtq7lx13hxtgm028bjy7'>
            <column caption='Status Popularitate' datatype='string' name='[Calculation_0320466494787584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [track_popularity] &gt; 70 THEN &quot;Popular&quot; ELSE &quot;Normal&quot; END' />
