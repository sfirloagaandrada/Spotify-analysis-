            <groupfilter function='level-members' level='[usr:Calculation_0320466523152386:nk]' />
          </filter>
          <slices>
            <column>[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[usr:Calculation_0320466523152386:nk]</column>
