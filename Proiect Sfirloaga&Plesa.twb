  <worksheets>
    <worksheet name='Analiza popularității artiștilor '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>Æ </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Analiza popularității artiștilor pe baza scorului Spotify.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='track_data_final.csv+ (Multiple Connections)' name='federated.1ayj8xl1dtq7lx13hxtgm028bjy7' />
          </datasources>
