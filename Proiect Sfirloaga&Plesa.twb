            <column caption='Artist Name' datatype='string' name='[artist_name]' role='dimension' type='nominal' />
            <column-instance column='[artist_name]' derivation='None' name='[none:artist_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[track_popularity (spotify_data clean.csv)]' derivation='None' name='[none:track_popularity (spotify_data clean.csv):qk]' pivot='key' type='quantitative' />
            <column-instance column='[track_popularity (spotify_data clean.csv)]' derivation='Sum' name='[sum:track_popularity (spotify_data clean.csv):qk]' pivot='key' type='quantitative' />
            <column caption='Track Popularity (Spotify Data Clean.Csv)' datatype='integer' name='[track_popularity (spotify_data clean.csv)]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[none:track_popularity (spotify_data clean.csv):qk]' included-values='in-range'>
            <min>0</min>
            <max>99</max>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[none:artist_name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[sum:track_popularity (spotify_data clean.csv):qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
            <column>[federated.1ayj8xl1dtq7lx13hxtgm028bjy7].[none:track_popularity (spotify_data clean.csv):qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
